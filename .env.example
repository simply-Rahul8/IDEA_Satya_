# Copy to .env (git-ignored). Placeholders only: never commit real values.
# Separate keys per environment (P9).

# LLM mode: mock (default; no network, no keys) | live
SATYA_LLM=mock

# LLM providers (read only from the environment, never printed)
SARVAM_API_KEY=
ANTHROPIC_API_KEY=

# Translation
INDICTRANS2_URL=
INDICTRANS2_TOKEN=

# Supabase (ap-south-1)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sentry
SENTRY_DSN=

# Environment name: local | preview | production (separate keys for each, P9)
SATYA_ENV=local

# Server-side Postgres URL for jobs/rate limits (service role; never sent to the browser)
SUPABASE_DB_URL=

# Auth: custom SMTP via Resend free tier (P28) and optional Google sign-in
RESEND_API_KEY=
SMTP_FROM_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limits (hits per window, P9)
RATE_LIMIT_USER_PER_MIN=30
RATE_LIMIT_PUBLIC_PER_HOUR=20

# Web security (SAT-34). SESSION_SECRET is required when SATYA_ENV is preview/production:
# a long random string, the same on every instance (e.g. `python -c "import secrets;print(secrets.token_hex(32))"`).
SATYA_SESSION_SECRET=
# Extra origins allowed to POST besides the request's own host (comma separated, e.g. a custom domain).
SATYA_ALLOWED_ORIGINS=
# Header the hosting platform sets with the real client IP. Leave blank locally; on Vercel it defaults to
# x-vercel-forwarded-for. X-Forwarded-For is never trusted.
SATYA_TRUSTED_IP_HEADER=
# Limits for every state-changing request except /check (per IP), and for /check
WRITE_RATE_LIMIT=300
WRITE_RATE_WINDOW_S=600
CHECKER_RATE_LIMIT=120
CHECKER_RATE_WINDOW_S=600
